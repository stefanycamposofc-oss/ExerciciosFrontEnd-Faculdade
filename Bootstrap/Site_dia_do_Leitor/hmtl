<!-- Modal: Autores Brasileiros -->
<div class="modal fade" id="modalAutores"
     tabindex="-1"
     aria-labelledby="tituloAutores"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">
                <h1 class="modal-title fs-5" id="tituloAutores">
                    Grandes Autores Brasileiros
                </h1>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fechar">
                </button>
            </div>

            <div class="modal-body">

                <h2 class="h5">Machado de Assis</h2>
                <p>
                    Machado de Assis nasceu em 1839,
                    no Rio de Janeiro. Foi um dos
                    fundadores da Academia Brasileira
                    de Letras.
                </p>
                <p>
                    Principais obras: Dom Casmurro,
                    Memórias Póstumas de Brás Cubas
                    e Quincas Borba.
                </p>

                <hr>

                <h2 class="h5">Carolina Maria de Jesus</h2>
                <p>
                    Carolina Maria de Jesus nasceu em 1914,
                    em Minas Gerais. Sua escrita retrata
                    a pobreza e as desigualdades sociais.
                </p>
                <p>
                    Principal obra: Quarto de Despejo.
                </p>

                <hr>

                <h2 class="h5">Jorge Amado</h2>
                <p>
                    Jorge Amado nasceu em 1912, na Bahia.
                    Foi um dos maiores representantes
                    da literatura brasileira.
                </p>
                <p>
                    Principais obras: Capitães da Areia,
                    Gabriela, Cravo e Canela e
                    Dona Flor e Seus Dois Maridos.
                </p>

            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-livro"
                        data-bs-dismiss="modal">
                    Fechar
                </button>
            </div>

        </div>
    </div>
</div>

