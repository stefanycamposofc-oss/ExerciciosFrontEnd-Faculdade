/* ===== Paleta Papel Envelhecido ===== */
:root {
    --pergaminho: #FAF5E9;
    --bege-papel: #EBDDBF;
    --sepia: #7A5C3E;
    --marrom-texto: #3E2C1F;
    --vinho: #7B2D26;
  }
  
  /* ===== Geral ===== */
  body {
    background-color: var(--pergaminho);
    color: var(--marrom-texto);
  }
  
  h1, h2, h3, h4, h5, h6,
  .navbar-brand,
  .modal-title {
    font-family: "Playfair Display", Georgia, serif;
  }
  
  .container {
    padding-bottom: 2rem;
  }
  
  .titulo-livro {
    color: var(--marrom-texto);
    font-weight: 700;
  }
  
  /* ===== Navbar ===== */
  .navbar-livro {
    background-color: var(--bege-papel);
    border-bottom: 2px solid var(--sepia);
  }
  
  .navbar-livro .navbar-brand {
    color: var(--marrom-texto);
    font-weight: 700;
  }
  
  .navbar-livro .navbar-brand i {
    color: var(--vinho);
    margin-right: 0.5rem;
  }
  
  .navbar-livro .nav-link {
    color: var(--sepia);
  }
  
  .navbar-livro .nav-link:hover,
  .navbar-livro .nav-link.active {
    color: var(--vinho);
  }
  
  .navbar-livro .navbar-toggler {
    border-color: var(--sepia);
  }
  
  /* Campo e botão de busca */
  .navbar-livro .form-control {
    background-color: var(--pergaminho);
    border-color: var(--sepia);
    color: var(--marrom-texto);
  }
  
  .navbar-livro .form-control:focus {
    border-color: var(--vinho);
    box-shadow: 0 0 0 0.2rem rgba(123, 45, 38, 0.2);
  }
  
  .btn-busca {
    --bs-btn-color: var(--vinho);
    --bs-btn-border-color: var(--vinho);
    --bs-btn-hover-color: var(--pergaminho);
    --bs-btn-hover-bg: var(--vinho);
    --bs-btn-hover-border-color: var(--vinho);
    --bs-btn-active-color: var(--pergaminho);
    --bs-btn-active-bg: var(--marrom-texto);
    --bs-btn-active-border-color: var(--marrom-texto);
  }
  
  /* ===== Botões ===== */
  .btn-livro {
    --bs-btn-color: var(--pergaminho);
    --bs-btn-bg: var(--vinho);
    --bs-btn-border-color: var(--vinho);
    --bs-btn-hover-color: var(--pergaminho);
    --bs-btn-hover-bg: var(--marrom-texto);
    --bs-btn-hover-border-color: var(--marrom-texto);
    --bs-btn-active-color: var(--pergaminho);
    --bs-btn-active-bg: var(--marrom-texto);
    --bs-btn-active-border-color: var(--marrom-texto);
    --bs-btn-focus-shadow-rgb: 123, 45, 38;
  }
  
  /* ===== Cards ===== */
  .card {
    background-color: var(--bege-papel);
    border: 1px solid var(--sepia);
  }
  
  /* ===== Badge ===== */
  .badge-livro {
    background-color: var(--vinho);
    color: var(--pergaminho);
  }
  
  /* ===== Notícias ===== */
  article {
    --bs-border-color: var(--sepia);
  }
  
  /* ===== Accordion ===== */
  .accordion {
    --bs-accordion-color: var(--marrom-texto);
    --bs-accordion-bg: var(--pergaminho);
    --bs-accordion-border-color: var(--sepia);
    --bs-accordion-btn-color: var(--marrom-texto);
    --bs-accordion-btn-bg: var(--bege-papel);
    --bs-accordion-active-color: var(--vinho);
    --bs-accordion-active-bg: var(--bege-papel);
    --bs-accordion-btn-focus-border-color: var(--sepia);
    --bs-accordion-btn-focus-box-shadow: 0 0 0 0.2rem rgba(123, 45, 38, 0.2);
    --bs-accordion-btn-active-icon: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%237B2D26'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
  }
  
  /* ===== Modal ===== */
  .modal-content {
    background-color: var(--pergaminho);
    border: 2px solid var(--sepia);
  }
  
  .modal-header {
    border-bottom-color: var(--sepia);
  }
  
  .modal-footer {
    border-top-color: var(--sepia);
  }

  html {
    scroll-behavior: smooth;
  }

  /* ===== Diálogo Autores Brasileiros ===== */

#scrollableBodyDialog {
    background-color: #FAF5E9;
    color: #3E2C1F;
    border: 2px solid #7A5C3E;
    border-radius: 12px;
    width: 90%;
    max-width: 650px;
    max-height: 85vh;
}

#scrollableBodyDialog .dialog-header {
    background-color: #EBDDBF;
    color: #3E2C1F;
}

#scrollableBodyDialog .dialog-body {
    padding: 20px;
    overflow-y: auto;
}

#scrollableBodyDialog .dialog-body h2 {
    color: #7B2D26;
    font-size: 24px;
}

#scrollableBodyDialog .dialog-footer {
    background-color: #EBDDBF;
}

#scrollableBodyDialog .btn-solid {
    background-color: #7B2D26;
    color: #FAF5E9;
    border: 1px solid #7B2D26;
    border-radius: 6px;
    padding: 8px 20px;
}

#scrollableBodyDialog .btn-solid:hover {
    background-color: #3E2C1F;
}
