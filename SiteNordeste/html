              <h2>Entre em Contato com o Guia</h2>
              <p>Tem dúvidas, quer dicas ou deseja agendar um passeio? Envie sua mensagem abaixo!</p>
          
              <form class="form-contato">
                <label for="nome">Nome</label>
                <input type="text" id="nome" placeholder="Digite seu nome" required>
          
                <label for="email">E-mail</label>
                <input type="email" id="email" placeholder="Digite seu melhor e-mail" required>
          
                <label for="mensagem">Mensagem</label>
                <textarea id="mensagem" rows="5" placeholder="Escreva sua mensagem" required></textarea>
          
                <button type="submit">Enviar</button>
              </form>
            </div>
          </section>
          

