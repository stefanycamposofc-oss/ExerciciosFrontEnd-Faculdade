        <section id="gallery">
            <h1>Pontos Turisticos</h1>
            <img src="img/alagoas.jpg" alt="Alagoas">
            <img src="img/bahia.jpg" alt="Bahia">
            <img src="img/ceara.jpg"alt="Ceará">
